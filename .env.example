# HerJourney Environment Configuration
# Optional: Provide a MongoDB Atlas connection string (e.g. mongodb+srv://...)
# If left empty, HerJourney automatically launches an embedded in-memory MongoDB instance
# with automatic seeding for Priya, Ananya, Meena, Lakshmi, Rukmini and ecosystem models.
MONGODB_URI=

# Port for backend API server
PORT=5000

# Client URL (for CORS policy)
CLIENT_URL=http://localhost:3000

